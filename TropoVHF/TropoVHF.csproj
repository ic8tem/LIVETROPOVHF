<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Windows: API del sistema per l'OCR integrato (lettura degli assi delle mappe). Le altre piattaforme restano net10.0. -->
    <TargetFramework Condition="'$(Win7)' != 'true' And '$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(Win7)' != 'true' And '$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Windows 7 e 8: .NET 10 (e già .NET 8) chiama GetSystemTimePreciseAsFileTime, che su Windows 7 non c'è.
         Con -p:Win7=true si compila su .NET 6, l'ultimo che gira su Windows 7 SP1; l'OCR di Windows 10 resta escluso. -->
    <TargetFramework Condition="'$(Win7)' == 'true'">net6.0</TargetFramework>
    <DefineConstants Condition="'$(Win7)' == 'true'">$(DefineConstants);WIN7</DefineConstants>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>LIVETROPOVHF</AssemblyName>
    <RootNamespace>TropoVHF</RootNamespace>
    <Version>1.0.1</Version>
    <Product>LIVETROPOVHF</Product>
    <ApplicationIcon>Assets\livetropovhf.ico</ApplicationIcon>
    <Description>Previsione e osservazione in tempo reale della propagazione troposferica VHF/UHF</Description>
    <Authors>IC8TEM</Authors>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1603;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="MQTTnet" Version="4.3.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Docs\*.md" />
    <EmbeddedResource Include="Assets\splash.jpg;Assets\livetropovhf.ico;Assets\livetropovhf-256.png" />
    <!-- database nominativi accanto al programma (anche nei pacchetti e negli installatori) -->
    <None Include="..\CALL3.TXT" Link="CALL3.TXT" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('..\CALL3.TXT')" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="TropoVHF.Lang.%(Filename).json" />
    <None Include="Tarature\*.json;Tarature\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
